var deepCrabOn   = input.bool(true, "Deep Crab:   ", inline="dcrab", group="02. Pattern Types")

// 03. Entry & Risk
var e_afterC     = input.bool(true, "Enter after Point C", group="03. Entry & Risk")
var e_lvlc       = input.string("Near confluent PRZ", "       Enter at", options=["Near confluent PRZ","Far confluent PRZ","Mid confluent PRZ","Nearest PRZ","Farthest PRZ"], group="03. Entry & Risk")
var e_aboveC     = input.float(90, "       If score is above", group="03. Entry & Risk", tooltip="Min score for C-entry. 0 allows all.")
var e_afterD     = input.bool(true, "Enter after Point D", group="03. Entry & Risk")
var e_lvldPct    = input.float(1.0, "       Enter at limit % away from D", minval=0.0, step=.1, group="03. Entry & Risk", tooltip="Max allowed distance from D for D-entry. If not filled, trade is excluded from stats.")
var e_aboveD     = input.float(90, "       If score is above", group="03. Entry & Risk", tooltip="Min score for D-entry. 0 allows all.")
var e_tLimit     = input.float(.5, "       Entry window (time limit)", group="03. Entry & Risk", tooltip="Entry window in pattern lengths. Unfilled entries expire.")
var stopPct      = input.float(75, "Stop", step=1.0, minval=0.0, group="03. Entry & Risk", inline="stop")
var stopB        = input.string("% to T1 beyond entry", "", options=["% beyond X/D","% beyond far PRZ","% beyond D","% beyond entry","% to T1 beyond entry"], group="03. Entry & Risk", inline="stop", tooltip="Stop reference mode for stopPct.")
var same_bar_resolution = input.string("Stop first (conservative)", "       Same-bar T/S policy", options=["Stop first (conservative)","Target first (optimistic)","Leave unresolved"], group="03. Entry & Risk", tooltip="How to resolve same-bar stop+target conflicts.")

// 04. Visibility & Filters
