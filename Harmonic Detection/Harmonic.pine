// ─── FUNCTIONS ─────────────────────────────────────────────

type PatColors
    color line
    color fill
    color txt
    color tt
    color tgt

debugY(float y) =>
    na(y) ? close : y

debugLog(string msg, int x, float y, bool isBull=true) =>
    if debug_on
        col = isBull ? color.new(#26A69A, 65) : color.new(#EF5350, 65)
        lb = label.new(x=x, y=debugY(y), text=msg, style=label.style_label_left, textcolor=color.white, color=col, size=size.tiny)
        array.push(debugLabels, lb)
        if array.size(debugLabels) > debug_max_labels
            label.delete(array.shift(debugLabels))

lifecycleDebug(string msg, h.xabcd_harmonic p) =>
    if debug_lifecycle
        yRef = not na(p.e.y) ? p.e.y : p.d.y
        debugLog("[LC] " + msg + " | " + p.pid, bar_index, yRef, p.bull)

legMidKey(string pid, string leg) =>
    pid + "|" + leg

deleteLegMidByKey(string key) =>
    n = array.size(legMidKeys)
    if n > 0
        for i=0 to n-1
            idx = n-1-i
            if array.get(legMidKeys, idx) == key
                removedLabel = array.remove(legMidLabels, idx)
                array.remove(legMidKeys, idx)
                label.delete(removedLabel)
                break

deleteLegMidAtPoint(string leg, int x, float y) =>
    n = array.size(legMidKeys)
    if n > 0
        for i=0 to n-1
            idx = n-1-i
            k = array.get(legMidKeys, idx)
            parts = str.split(k, "|")
            kLeg = array.size(parts) > 1 ? array.get(parts, 1) : ""
            lb = array.get(legMidLabels, idx)
            sameX = label.get_x(lb) == x
            sameY = math.abs(label.get_y(lb) - y) <= (syminfo.mintick * 2.0)
            if kLeg == leg and sameX and sameY
                removedLabel = array.remove(legMidLabels, idx)
                array.remove(legMidKeys, idx)
                label.delete(removedLabel)

patternIndexByPid(h.xabcd_harmonic[] arr, string pid) =>
    idx = -1
    n = array.size(arr)
    if not na(pid) and n > 0
        for i=0 to n-1
            pat = array.get(arr, i)
            if pat.pid == pid
                idx := i
                break
    idx

pidCacheAdd(string pid) =>
    if not na(pid) and pid != "" and array.indexof(pidCache, pid) < 0
        array.push(pidCache, pid)
    0

pidCacheAddArray(h.xabcd_harmonic[] arr) =>
    if array.size(arr) > 0
        for p in arr
            pidCacheAdd(p.pid)
    0

pidCacheRemove(string pid) =>
    idx = array.indexof(pidCache, pid)
    if idx >= 0
        array.remove(pidCache, idx)
    0

patternPidExists(string pid) =>
    array.indexof(pidCache, pid) >= 0

reconcileLegMidLabels() =>
    n = array.size(legMidKeys)
    if n > 0
        for i=0 to n-1
            idx = n-1-i
            k = array.get(legMidKeys, idx)
            parts = str.split(k, "|")
            pid = array.size(parts) > 0 ? array.get(parts, 0) : ""
            hidden = pid != "" and array.indexof(hiddenClusterPids, pid) >= 0
            stale = pid == "" or not patternPidExists(pid) or hidden
            if stale
                removedLabel = array.remove(legMidLabels, idx)
                array.remove(legMidKeys, idx)
                label.delete(removedLabel)

removeLegMidLabels(string pid) =>
    n = array.size(legMidKeys)
    if n > 0
        pref = pid + "|"
        for i=0 to n-1
            idx = n-1-i
            k = array.get(legMidKeys, idx)
            if str.startswith(k, pref)
                removedLabel = array.remove(legMidLabels, idx)
                array.remove(legMidKeys, idx)
                label.delete(removedLabel)

clearLegMidLabels() =>
    for lb in legMidLabels
        label.delete(lb)
    array.clear(legMidLabels)
    array.clear(legMidKeys)

drawLegMidLabel(string pid, string legKey, string txt, int x1, float y1, int x2, float y2, color c) =>
    key = legMidKey(pid, legKey)
    mx = int(math.round((x1 + x2) / 2.0))
    my = (y1 + y2) / 2.0
    deleteLegMidByKey(key)
    deleteLegMidAtPoint(legKey, mx, my)
    lb = label.new(mx, my, text=txt, style=label.style_label_center, textcolor=color.white, color=color.new(c, 75), size=size.tiny)
    array.push(legMidKeys, key)
    array.push(legMidLabels, lb)

customFillKey(string pid, int legIdx) =>
    pid + "|F|" + str.tostring(legIdx)

clearCustomFillsForPid(string pid) =>
    n = array.size(customFillKeys)
    if n > 0
        pref = pid + "|F|"
        for i=0 to n-1
            idx = n-1-i
            k = array.get(customFillKeys, idx)
            if str.startswith(k, pref)
                lf = array.remove(customFills, idx)
                array.remove(customFillKeys, idx)
                linefill.delete(lf)
    0

trackCustomFill(string pid, int legIdx, linefill lf) =>
    array.push(customFillKeys, customFillKey(pid, legIdx))
    array.push(customFills, lf)
    0

ratioTxt(float r) =>
    na(r) ? "NA" : str.tostring(r, "#.###")

legLabelColor(float err, color fallback) =>
    if not leg_lbl_color_by_acc or na(err)
        color.new(fallback, 75)
    else
        exactTol = leg_exact_eps_pct / 100.0
        e = math.abs(err)
        e <= exactTol ? c_leg_exact : e <= 0.05 ? c_leg_5pct : e <= 0.10 ? c_leg_10pct : c_leg_out

drawLegMidLabels(h.xabcd_harmonic p, PatColors col) =>
    if show_leg_mid_labels
        removeLegMidLabels(p.pid)
        xbErr = p.tp == 5 ? na : p.re_xb
        drawLegMidLabel(p.pid, "XB", "XB " + ratioTxt(p.r_xb), p.x.x, p.x.y, p.b.x, p.b.y, legLabelColor(xbErr, col.line))
        drawLegMidLabel(p.pid, "AC", "AC " + ratioTxt(p.r_ac), p.a.x, p.a.y, p.c.x, p.c.y, legLabelColor(p.re_ac, col.line))
        if h.is_complete(p)
            drawLegMidLabel(p.pid, "BD", "BD " + ratioTxt(p.r_bd), p.b.x, p.b.y, p.d.x, p.d.y, legLabelColor(p.re_bd, col.line))
            drawLegMidLabel(p.pid, "XD", "XD " + ratioTxt(p.r_xd), p.x.x, p.x.y, p.d.x, p.d.y, legLabelColor(p.re_xd, col.line))
    else
        removeLegMidLabels(p.pid)
    0

// renderFibRow: one row of the fib tolerance table.
// Computes 5%/10% bounds from fib value. Key fibs (0.618, 0.786, 1.618, 2.618) get gold highlight.

renderFibRow(t, r, fib) =>
    lo5  = fib * (1 - 0.05)
    hi5  = fib * (1 + 0.05)
    lo10 = fib * (1 - 0.10)
    hi10 = fib * (1 + 0.10)
    isKey = fib == 0.618 or fib == 0.786 or fib == 1.618 or fib == 2.618
    bg    = r % 2 == 0 ? color.new(color.black, 50) : color.new(color.black, 65)
    fc    = isKey ? color.new(#FFD600, 70) : bg

    table.cell(t, 0, r, str.tostring(fib,  "#.###"), bgcolor=fc, text_color=color.white,                text_size=size.small, text_halign=text.align_center)
    table.cell(t, 1, r, str.tostring(lo5,  "#.###"), bgcolor=bg, text_color=color.new(#00E676, 0),      text_size=size.small, text_halign=text.align_center)
    table.cell(t, 2, r, str.tostring(hi5,  "#.###"), bgcolor=bg, text_color=color.new(#00E676, 0),      text_size=size.small, text_halign=text.align_center)
    table.cell(t, 3, r, str.tostring(lo10, "#.###"), bgcolor=bg, text_color=color.new(#FFD600, 0),      text_size=size.small, text_halign=text.align_center)
    table.cell(t, 4, r, str.tostring(hi10, "#.###"), bgcolor=bg, text_color=color.new(#FFD600, 0),      text_size=size.small, text_halign=text.align_center)

// printFibTable: renders fib tolerance reference table at top-right.
// Toggled by show_fib_table. Only runs on barstate.islast.

printFibTable() =>
    if barstate.islast and show_fib_table
        table.clear(fibTbl, 0, 0, 4, 16)
        table.cell(fibTbl, 0, 0, "Fib",      text_color=color.white, text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.gray, 50))
        table.cell(fibTbl, 1, 0, "5% Low",   text_color=color.new(#00E676, 0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.gray, 50))
        table.cell(fibTbl, 2, 0, "5% High",  text_color=color.new(#00E676, 0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.gray, 50))
        table.cell(fibTbl, 3, 0, "10% Low",  text_color=color.new(#FFD600, 0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.gray, 50))
        table.cell(fibTbl, 4, 0, "10% High", text_color=color.new(#FFD600, 0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.gray, 50))

        for i = 0 to array.size(fibLevels) - 1
            renderFibRow(fibTbl, i + 1, array.get(fibLevels, i))

// patColors: resolves the five color slots for a pattern type and direction.
// use_per_pattern=true → per-type colors. false → global bull/bear colors.

safeArrayColor(color[] a, int idx, color fallback) =>
    idx >= 0 and idx < array.size(a) ? array.get(a, idx) : fallback

patColors(int tp, bool bull) =>
    perPatternBase = safeArrayColor(patternBase, tp - 1, c_gart_base)
    bullBear = bull ? safeArrayColor(bullBearBase, 0, c_bull_base) : safeArrayColor(bullBearBase, 1, c_bear_base)
    base = use_per_pattern ? perPatternBase : bullBear
    txtBase = use_per_pattern ? base : color.white
    PatColors.new(color.new(base, 20), color.new(base, 70), color.new(txtBase, 20), color.new(base, 80), color.new(base, 40))

// drawFills: overrides library fill by creating linefills between adjacent legs
// (XA–AB, AB–BC, BC–CD). Called last in drawPattern() to render over library fills.
// p.pLines[0..3] = leg lines. [4..5] = PRZ horizontals (left untouched).

drawFills(p, col) =>
    ls = p.pLines

    clearCustomFillsForPid(p.pid)
    if array.size(ls) >= 4
        lf0 = linefill.new(array.get(ls, 0), array.get(ls, 1), color.new(col.fill, 60))
        lf1 = linefill.new(array.get(ls, 1), array.get(ls, 2), color.new(col.fill, 60))
        lf2 = linefill.new(array.get(ls, 2), array.get(ls, 3), color.new(col.fill, 60))
        trackCustomFill(p.pid, 0, lf0)
        trackCustomFill(p.pid, 1, lf1)
        trackCustomFill(p.pid, 2, lf2)

// storageFor: resolves isBull + pattern type ID to the correct storage array.

storageFor(isBull, tp) =>
    switch tp
        1 => isBull ? bullGart  : bearGart
        2 => isBull ? bullBat   : bearBat
        3 => isBull ? bullBfly  : bearBfly
        4 => isBull ? bullCrab  : bearCrab
        5 => isBull ? bullShark : bearShark
        => array.new<h.xabcd_harmonic>()

// Range-based target model:
// T1 = 0.382 of XABC range (highest-to-lowest), projected from D.
// T2 = 0.618 of XABC range (golden pocket anchor), projected from D.

harmRangeHiLo(float xY, float aY, float bY, float cY) =>
    hi = math.max(math.max(math.max(xY, aY), bY), cY)
    lo = math.min(math.min(math.min(xY, aY), bY), cY)
    [hi, lo]

rangeTargetFromD(bool bull, float xY, float aY, float bY, float cY, float dY, float ratio) =>
    [hi, lo] = harmRangeHiLo(xY, aY, bY, cY)
    rng = hi - lo
    bull ? (dY + (rng * ratio)) : (dY - (rng * ratio))

harmonic_xabcd_targets(bool bull, float xY, float aY, float bY, float cY, float dY) =>
    t1 = rangeTargetFromD(bull, xY, aY, bY, cY, dY, 0.382)
    t2 = rangeTargetFromD(bull, xY, aY, bY, cY, dY, 0.618)
    [t1, t2]

// tLimit: max bars for a completed pattern to reach targets = (D-X) * tLimitMult
// incTLimit: max bars for an incomplete pattern to find D, scaled by pctAsym
// entryWindowExpired: true when entry window has expired = (bar_index-D) > (D-X)*e_tLimit
// stillActive: true when within time limit AND entry window still open

tLimit(xX,dX) =>
    na(xX) or na(dX) ? 0 : int((dX - xX)*tLimitMult)

pendingLimit(xX,dX) =>
    dyn = tLimit(xX,dX)
    pendingMaxBars > 0 ? math.min(dyn, pendingMaxBars) : dyn

incTLimit(xX,cX) =>
    avg = (cX-xX)/3
    dyn = int(avg * (1 + pctAsym/100))
    incompleteMaxBars > 0 ? math.min(dyn, incompleteMaxBars) : dyn

entryWindowExpired(xX,dX) =>
    na(xX) or na(dX) ? false : bar_index - dX > int((dX - xX)*e_tLimit)

stillActive(xX,dX) =>
    not na(xX) and not na(dX) and bar_index - pendingLimit(xX,dX) <= dX and entryWindowExpired(xX,dX) == false

effectivePreset() =>
    detection_preset

effectiveValidationBars() =>
    pref = effectivePreset()
    pref == "Scalp" ? 1 : pref == "Swing" ? 2 : pref == "Macro+" ? 3 : t_b

presetMinPl() =>
    pref = effectivePreset()
    pref == "Scalp" ? 5 : pref == "Swing" ? 8 : pref == "Macro+" ? 15 : min_pl

// belowScoreThreshold: true if pattern score is below the configured entry threshold.
// Uses e_aboveD for complete patterns, e_aboveC for incomplete.

belowScoreThreshold(h.xabcd_harmonic p) =>
    h.is_complete(p) ? p.score < (e_aboveD/100) : p.score < (e_aboveC/100)

// entry: computes entry price using the configured mode (after C / after D / PRZ).
// Returns [entryLevel, afterCLevel, afterDLevel] or [na,na,na] if score too low.

entry(p) =>
    if belowScoreThreshold(p)
        [na,na,na]
    else
        ta.harmonic_xabcd_entry(p.bull,p.tp,p.x.y,p.a.y,p.b.y,p.c.y,p.d.y,e_afterC,canonEntryMode,e_afterD,e_lvldPct)

// entryHit: checks if price has reached the entry level this bar.
// Returns [hit, barIndex, price]. [false,na,na] if timed out. [na,na,na] if entry > T1.

entryHit(p) =>
    vBars = effectiveValidationBars()
    if p.eHit or p.eHit == false
        [p.eHit,p.e.x,p.e.y]
    else if (not h.is_complete(p) and entryWindowExpired(p.x.x,p.d.x)) or belowScoreThreshold(p)
        [false,na,na]
    else
        [_,afterC,afterD] = entry(p)
        [eH,eX,eY] = ta.xabcd_entryHit(p.bull, afterC, afterD, p.d.x, e_afterC, e_afterD, vBars)
        if not na(eY) and ((p.bull and p.t1<eY) or (p.bull==false and p.t1>eY))
            [na,na,na]
        else
            [eH,eX,eY]

entryCandidateInvalid(h.xabcd_harmonic p, float level) =>
    not na(level) and ((p.bull and p.t1 < level) or (p.bull==false and p.t1 > level))

entryCandidatesInvalid(h.xabcd_harmonic p) =>
    [_, afterC, afterD] = entry(p)
    hasCandidates = not na(afterC) or not na(afterD)
    anyValid = (not na(afterC) and not entryCandidateInvalid(p, afterC)) or (not na(afterD) and not entryCandidateInvalid(p, afterD))
    hasCandidates and not anyValid

tradeLevelsValid(h.xabcd_harmonic p, float eY) =>
    if na(eY) or na(p.stop) or na(p.t1) or na(p.t2)
        false
    else if p.bull
        p.stop < eY and p.t1 > eY and p.t2 >= p.t1
    else
        p.stop > eY and p.t1 < eY and p.t2 <= p.t1

sanitizeLifecycle(h.xabcd_harmonic p) =>
    if p.eHit != true
        if not na(p.t1Hit) or not na(p.t2Hit) or p.sHit
            lifecycleDebug("Reset outcomes because entry is not filled", p)
        p.t1Hit := na
        p.t2Hit := na
        p.sHit := false
    else
        if p.t2Hit and p.t1Hit != true
            p.t1Hit := true
            lifecycleDebug("Promoted T1 because T2 is hit", p)
        if p.t2Hit and p.sHit
            if same_bar_resolution == "Target first (optimistic)"
                p.sHit := false
                lifecycleDebug("Dropped stop on T2+Stop conflict (target-first)", p)
            else
                p.t2Hit := na
                if na(p.t1Hit)
                    p.t1Hit := false
                lifecycleDebug("Dropped T2 on T2+Stop conflict", p)
    0

sameBarGapPrefersTarget(h.xabcd_harmonic p) =>
    pref = bool(na)
    if same_bar_gap_hint and not na(close[1])
        if p.bull
            gapToT = not na(p.t2) and open >= p.t2 and close[1] < p.t2
            gapToS = not na(p.stop) and open <= p.stop and close[1] > p.stop
            if gapToT and not gapToS
                pref := true
            else if gapToS and not gapToT
                pref := false
        else
            gapToT = not na(p.t2) and open <= p.t2 and close[1] > p.t2
            gapToS = not na(p.stop) and open >= p.stop and close[1] < p.stop
            if gapToT and not gapToS
                pref := true
            else if gapToS and not gapToT
                pref := false
    pref

resolveFallbackHitState(h.xabcd_harmonic p, bool t1h, bool t2h, bool sH, int t1x, float t1y, int t2x, float t2y) =>
    if na(t1h) and na(t2h) and sH != true
        hitT2 = not na(p.t2) and (p.bull ? high >= p.t2 : low <= p.t2)
        hitT1 = not na(p.t1) and (p.bull ? high >= p.t1 : low <= p.t1)
        hitS  = not na(p.stop) and (p.bull ? low <= p.stop : high >= p.stop)
        if hitS and (hitT1 or hitT2)
            gapPrefTarget = sameBarGapPrefersTarget(p)
            if gapPrefTarget == false or (na(gapPrefTarget) and same_bar_resolution == "Stop first (conservative)")
                [false, na, true, bar_index, p.stop, na, na]
            else if gapPrefTarget or same_bar_resolution == "Target first (optimistic)"
                if hitT2
                    [true, true, false, bar_index, p.t1, bar_index, p.t2]
                else
                    [true, na, false, bar_index, p.t1, na, na]
            else
                [t1h,t2h,sH,t1x,t1y,t2x,t2y]
        else if hitS
            [false, na, true, bar_index, p.stop, na, na]
        else if hitT2
            [true, true, false, bar_index, p.t1, bar_index, p.t2]
        else if hitT1
            [true, na, false, bar_index, p.t1, na, na]
        else
            [t1h,t2h,sH,t1x,t1y,t2x,t2y]
    else
        [t1h,t2h,sH,t1x,t1y,t2x,t2y]

// success: checks T1/T2/stop resolution each bar for a pending pattern.
// Delegates to t.tradeClosed() while within tLimit. Returns [t1Hit,t2Hit,sHit,t1x,t1y,t2x,t2y].

success(p) =>
    if p.sHit or p.t2Hit
        [p.t1Hit,p.t2Hit,p.sHit,na,na,na,na]
    else if bar_index <= (p.d.x + pendingLimit(p.x.x,p.d.x)) and p.eHit
        [t1h,t2h,sH,t1x,t1y,t2x,t2y] = ta.tradeClosed(p.e.x,p.e.y,p.stop,p.t1Hit,p.t2Hit,p.t1,p.t2)
        resolveFallbackHitState(p, t1h, t2h, sH, t1x, t1y, t2x, t2y)
    else
        [p.t1Hit,p.t2Hit,p.sHit,na,na,na,na]

alertMsg(p) =>
    if not h.is_complete(p)
        "Potential " + h.get_name(p) + " is forming."
    else
        h.get_name(p) + " has formed."

// clearProjectionOverlay: clears all drawing objects for the in-progress projection overlay.

clearProjectionOverlay() =>
    for lbl in fullIpL
        label.delete(lbl)
    array.clear(fullIpL)
    for ln in fullIpLn
        line.delete(ln)
    array.clear(fullIpLn)
    for lf in fullIpLf
        linefill.delete(lf)
    array.clear(fullIpLf)

// removePending: removes a pattern from pending[] by pid.
// Also clears the in-progress overlay if the removed pattern was the last one.

removePending(pid) =>
    idx = patternIndexByPid(pending, pid)
    if idx >= 0
        if idx == array.size(pending)-1
            clearProjectionOverlay()
        array.remove(pending, idx)

// patternState: canonical lifecycle resolver shared by tooltips, labels and stats.
// State glossary:
// 0=t2Hit         trade reached T2
// 1=t1Hit         trade reached T1 only
// 2=stopped       stop reached before target completion
// 3=noEntry       score gate blocks entry while still active
// 4=missedEntry   entry window closed without fill
// 5=entryPending  waiting for entry fill
// 6=targetsPending entry filled, waiting for T1/T2/stop
// 7=timedOut      lifecycle exceeded pending limit
// 8=entryExpired   entry filled, but no target/stop before time limit

patternState(p) =>
    active = stillActive(p.x.x, p.d.x)
    scoreBlocked = belowScoreThreshold(p)
    if p.t2Hit
        0
    else if p.t1Hit
        1
    else if p.sHit
        2
    else if scoreBlocked and active
        3
    else if p.eHit == false
        4
    else if na(p.eHit) and active
        5
    else if na(p.eHit)
        4
    else if na(p.t1Hit) and active
        6
    else if p.eHit and na(p.t1Hit) and not active
        8
    else
        7
        
successTxt(p) =>
    var string[] stateTxtMap = array.from(" (Success - Target 1, Target 2)", " (Success - Target 1)", " (Failed)", " (No entry)", " (Missed entry)", " (Entry pending)", " (Targets pending)", " (Timed out)", " (Entry expired)")
    st = patternState(p)
    st >= 0 and st < array.size(stateTxtMap) ? array.get(stateTxtMap, st) : " (Timed out)"

ratToStr(r) =>
    na(r) ? "NA    " : str.tostring(r, "0.000")

reToStr(r) =>
    na(r) ? "NA    " : str.tostring(r, "0.0") + "%"

pctStr(v) =>
    str.tostring(v, "#.##") + "%"

safeAvg(float sum, int count) =>
    count > 0 ? (sum / count) : float(na)

// legQ: quality indicator for a leg's fib error (uses p.re_* decimal ratio fields).
// ✓ within 5% | ~ within 10% | ✗ outside 10% — aligns with fib tolerance table tiers.

legQ(err) =>
    na(err) ? "-" : math.abs(err) <= 0.05 ? "✓" : math.abs(err) <= 0.10 ? "~" : "✗"

// tooltipText: builds pattern tooltip text.
// Layout and sections are controlled by Display settings.
// XD error% is intentionally omitted; XD is shown as actual ratio + theoretical target.

tooltipText(p) =>
    [rb,rc,rd1,rd2] = ta.harmonic_xabcd_fibDispTxt(p.tp)
    [_,_,e] = entry(p)
    eY   = na(p.e.y) ? e : p.e.y
    rr1  = not na(eY) and not na(p.t1) and not na(p.stop) ? math.abs(eY - p.t1) / math.max(math.abs(p.stop - eY), 0.0001) : float(na)
    rr2  = not na(eY) and not na(p.t2) and not na(p.stop) ? math.abs(eY - p.t2) / math.max(math.abs(p.stop - eY), 0.0001) : float(na)
    xbQ  = legQ(p.re_xb)
    acQ  = legQ(p.re_ac)
    bdQ  = legQ(p.re_bd)
    xdQ  = legQ(p.re_xd)
    compact = tt_layout == "Compact"
    string tip = h.get_name(p) + (compact ? "" : successTxt(p)) + "\n\n"
    tip += "Score: " + str.tostring(p.score*100,"#.##") + (not h.is_complete(p) ? "  [incomplete]" : "") + "\n\n"

    if tt_show_leg_err
        tip += "Leg | Actual | Err | Theoretical\n"
        tip += "XB " + xbQ + " | " + str.tostring(p.r_xb,"0.000") + " | " + (p.tp==5 ? "NA" : str.tostring(p.re_xb*100,"#.0") + "%") + " | " + rb + "\n"
        tip += "AC " + acQ + " | " + str.tostring(p.r_ac,"0.000") + " | " + str.tostring(p.re_ac*100,"#.0") + "%" + " | " + rc + "\n"
        tip += "BD " + bdQ + " | " + ratToStr(p.r_bd) + " | " + reToStr(p.re_bd) + " | " + rd1 + "\n"
    else
        tip += "Leg | Actual | Theoretical\n"
        tip += "XB " + xbQ + " | " + str.tostring(p.r_xb,"0.000") + " | " + rb + "\n"
        tip += "AC " + acQ + " | " + str.tostring(p.r_ac,"0.000") + " | " + rc + "\n"
        tip += "BD " + bdQ + " | " + ratToStr(p.r_bd) + " | " + rd1 + "\n"

    tip += "XD " + xdQ + " | " + ratToStr(p.r_xd) + " | " + rd2 + "\n\n"
    if tt_show_trade_levels
        tip += "Entry:   " + str.tostring(na(eY) ? float(na) : eY, "#.####") + "\n"
        tip += "Stop:    " + (na(p.stop) ? "NA" : str.tostring(p.stop,"#.####")) + "\n"
        tip += "T1:      " + str.tostring(p.t1,"#.####") + "\n"
        tip += "T2:      " + str.tostring(p.t2,"#.####") + "\n"
        if tt_show_rr and not na(rr1)
            tip += "R:R T1:  " + str.tostring(rr1,"#.##") + " : 1\n"
        if tt_show_rr and not na(rr2)
            tip += "R:R T2:  " + str.tostring(rr2,"#.##") + " : 1"
    tip


stateGlyph(p) =>
    var string[] stateGlyphMap = array.from(" ✅✅", " ✅", " ❌", " ⛔", " ⛔", " ⏳", " ⏳", " 🕝", " 🕝")
    st = patternState(p)
    st >= 0 and st < array.size(stateGlyphMap) ? array.get(stateGlyphMap, st) : " 🕝"

isPatternActive(p) =>
    if not h.is_complete(p)
        true
    else
        st = patternState(p)
        st == 5 or st == 6

displayColors(PatColors col, bool active) =>
    active ? col : PatColors.new(color.new(col.line, 70), color.new(col.fill, 85), color.new(col.txt, 70), color.new(col.tt, 80), color.new(col.tgt, 75))

fibTolPct() =>
    pref = effectivePreset()
    band = pref == "Macro+" ? "5%" : pref == "Custom" ? fib_tol_band : "10%"
    band == "5%" ? 0.05 : 0.10

ratioMatchesFibBand(float ratio, float tolPct) =>
    bool ok = false
    if not na(ratio)
        for i=0 to array.size(fibLevels)-1
            fib = array.get(fibLevels, i)
            err = math.abs(ratio - fib) / fib
            if err <= tolPct
                ok := true
                break
    ok

patternRatiosPassBand(h.xabcd_harmonic pat, bool requireDLegs=false) =>
    tol = fibTolPct()
    xbOk = pat.tp == 5 ? true : ratioMatchesFibBand(pat.r_xb, tol)
    acOk = ratioMatchesFibBand(pat.r_ac, tol)
    bdOk = requireDLegs ? ratioMatchesFibBand(pat.r_bd, tol) : true
    xdOk = requireDLegs ? ratioMatchesFibBand(pat.r_xd, tol) : true
    xbOk and acOk and bdOk and xdOk

clusterKeyX(h.xabcd_harmonic p) =>
    na(p.d.x) ? p.c.x : p.d.x

clusterKeyY(h.xabcd_harmonic p) =>
    na(p.d.y) ? p.c.y : p.d.y

clusterZone(h.xabcd_harmonic p) =>
    [upRaw, loRaw] = h.prz_range(p)
    ky = clusterKeyY(p)
    up = na(upRaw) ? ky : upRaw
    lo = na(loRaw) ? ky : loRaw
    hi = math.max(up, lo)
    lw = math.min(up, lo)
    [hi, lw]

clusterZoneWidth(h.xabcd_harmonic p) =>
    [hi, lw] = clusterZone(p)
    math.max(math.abs(hi - lw), syminfo.mintick * 2)

clusterCandidateAllowed(h.xabcd_harmonic p) =>
    base = h.is_complete(p) or incOn
    histGate = cluster_hist_completed_only and barstate.ishistory
    base and (not histGate or h.is_complete(p))

clusterOverlap(h.xabcd_harmonic a, h.xabcd_harmonic b) =>
    dxClose = math.abs(clusterKeyX(a) - clusterKeyX(b)) <= cluster_d_window
    [aHi, aLo] = clusterZone(a)
    [bHi, bLo] = clusterZone(b)
    rangeOverlap = math.max(aLo, bLo) <= math.min(aHi, bHi)
    aMid = (aHi + aLo) / 2.0
    bMid = (bHi + bLo) / 2.0
    maxW = math.max(clusterZoneWidth(a), clusterZoneWidth(b))
    centerClose = math.abs(aMid - bMid) <= (maxW * cluster_price_mult)
    dxClose and (rangeOverlap or centerClose)

// clusterCoarseCandidate: fast prefilter before full overlap math.
// Skips obviously distant patterns to reduce expensive winner comparisons.
clusterCoarseCandidate(h.xabcd_harmonic a, h.xabcd_harmonic b) =>
    dx = math.abs(clusterKeyX(a) - clusterKeyX(b))
    if dx > cluster_d_window
        false
    else
        [aHi, aLo] = clusterZone(a)
        [bHi, bLo] = clusterZone(b)
        aMid = (aHi + aLo) / 2.0
        bMid = (bHi + bLo) / 2.0
        maxW = math.max(clusterZoneWidth(a), clusterZoneWidth(b))
        math.abs(aMid - bMid) <= (maxW * cluster_price_mult)

clusterBetter(h.xabcd_harmonic a, h.xabcd_harmonic q) =>
    // Tie-break policy (highest priority first):
    // 1) Complete over incomplete
    // 2) Valid D over invalid D
    // 3) Higher score
    // 4) Entry-hit over not entry-hit
    // 5) Narrower PRZ width
    // 6) More recent pivot (higher key X)
    if h.is_complete(a) != h.is_complete(q)
        h.is_complete(a)
    else
        invA = a.invalid_d == true ? 1 : 0
        invB = q.invalid_d == true ? 1 : 0
        if invA != invB
            invA < invB
        else if math.abs(a.score - q.score) > 0.000001
            a.score > q.score
        else
            eA = a.eHit == true ? 1 : 0
            eB = q.eHit == true ? 1 : 0
            if eA != eB
                eA > eB
            else
                wA = clusterZoneWidth(a)
                wB = clusterZoneWidth(q)
                if math.abs(wA - wB) > syminfo.mintick
                    wA < wB
                else
                    clusterKeyX(a) > clusterKeyX(q)

clusterIsWinner(h.xabcd_harmonic p, h.xabcd_harmonic[] group) =>
    win = true
    n = array.size(group)
    if n > 1
        for i=0 to n-1
            q = array.get(group, i)
            if q.pid != p.pid and clusterCandidateAllowed(q) and clusterCoarseCandidate(p, q) and clusterOverlap(p, q)
                if clusterBetter(q, p)
                    win := false
                    break
    win

isClusterHidden(string pid) =>
    idx = array.indexof(hiddenClusterPids, pid)
    idx >= 0

setClusterHidden(string pid, bool hide) =>
    idx = array.indexof(hiddenClusterPids, pid)
    if hide and idx < 0
        array.push(hiddenClusterPids, pid)
        0
    else if (not hide) and idx >= 0
        array.remove(hiddenClusterPids, idx)
        0
    else
        0

collectDirectionTypePatterns(bool isBull, int tp) =>
    h.xabcd_harmonic[] all = array.new<h.xabcd_harmonic>()
    arr = storageFor(isBull, tp)
    if array.size(arr) > 0
        for i=0 to array.size(arr)-1
            array.push(all, array.get(arr, i))
    if array.size(incompletePatterns) > 0
        for p in incompletePatterns
            if p.bull == isBull and p.tp == tp
                array.push(all, p)
    all

tablePatternBadge(int tp) =>
    var string[] badges = array.from("GRT", "BAT", "BFL", "CRB", "SHK")
    idx = tp - 1
    idx >= 0 and idx < array.size(badges) ? array.get(badges, idx) : "SHK"

labelText(p,stateTxt) =>
    h.get_symbol(p.tp) + " " + str.tostring(math.round(p.score,3)*100) + stateTxt

incompleteLabelText(p) =>
    "Potential " + h.get_symbol(p.tp) + " (" + str.tostring(p.score*100,"#.##") + ")"

// refreshPatternLabel: single label refresh path for completed/pending patterns.

refreshPatternLabel(h.xabcd_harmonic pat) =>
    col = patColors(pat.tp, pat.bull)
    h.erase_label(pat)
    h.draw_label(pat, col.tt, l_txt, labelText(pat,stateGlyph(pat)), tooltipText(pat))

// erasePattern: removes all library-drawn objects for a pattern (lines, fills, label).

erasePattern(p) =>
    h.erase_pattern(p)
    h.erase_label(p)
    clearCustomFillsForPid(p.pid)
    removeLegMidLabels(p.pid)

removeIncomplete(string pid) =>
    idx = patternIndexByPid(incompletePatterns, pid)
    if idx >= 0
        p = array.remove(incompletePatterns, idx)
        erasePattern(p)
        pidCacheRemove(pid)

// drawPattern: renders a complete or incomplete pattern on chart.
// drawFills() is called last so custom fill colors override library fills.

drawPattern(p) =>
    if incOn or h.is_complete(p)
        colRaw = patColors(p.tp, p.bull)
        col = displayColors(colRaw, isPatternActive(p))
        stateTxt = stateGlyph(p)
        str_label = h.is_complete(p) ? labelText(p,stateTxt) : incompleteLabelText(p)
        tt = tooltipText(p)
        
        h.draw_pattern(p, col.line)
        if p.invalid_d
            line.set_style(array.get(p.pLines,3),line.style_dashed)
        h.erase_label(p)
        h.draw_label(p, col.tt, l_txt, str_label, tt)
        drawLegMidLabels(p, col)
        drawFills(p, col)
        if show_inc_prz and not h.is_complete(p)
            [ln, lf] = h.draw_prz_levels(p, col.line)
            array.push(p.pLines, ln)
            array.push(p.pLines, lf)
    else
        removeLegMidLabels(p.pid)

applyClusterVisibility(h.xabcd_harmonic p, bool shouldShow) =>
    hidden = isClusterHidden(p.pid)
    if shouldShow
        if hidden
            drawPattern(p)
            setClusterHidden(p.pid, false)
    else
        if not hidden
            erasePattern(p)
            setClusterHidden(p.pid, true)

refreshDirectionCluster(bool isBull) =>
    for tp=1 to 5
        group = collectDirectionTypePatterns(isBull, tp)
        if array.size(group) > 0
            for i=0 to array.size(group)-1
                p = array.get(group, i)
                allow = clusterCandidateAllowed(p)
                show = allow and clusterIsWinner(p, group)
                applyClusterVisibility(p, show)

refreshClusterFilter() =>
    if cluster_ui_filter
        refreshDirectionCluster(true)
        refreshDirectionCluster(false)
        0
    else
        if array.size(hiddenClusterPids) > 0
            refreshDirectionCluster(true)
            refreshDirectionCluster(false)
            array.clear(hiddenClusterPids)
        0

rangeLow(n, o=0) =>
    if n >= o
        v = low[o]
        for i=o to n
            if low[i] < v
                v := low[i]
        v

rangeHigh(n, o=0) =>
    if n >= o
        v = high[o]
        for i=o to n
            if high[i] > v
                v := high[i]
        v

// rangeBoundsFromC: caches [high, low] bounds from C to current bar (with offset)
// for the current bar execution to avoid repeating identical range scans.
rangeBoundsFromC(cX, o=1) =>
    var int cacheBar = na
    var int[] cacheKeys = array.new_int(0)
    var float[] cacheHigh = array.new_float(0)
    var float[] cacheLow = array.new_float(0)

    if na(cacheBar) or cacheBar != bar_index
        cacheBar := bar_index
        array.clear(cacheKeys)
        array.clear(cacheHigh)
        array.clear(cacheLow)

    key = (cX * 8192) + o
    idx = array.indexof(cacheKeys, key)
    if idx >= 0
        [array.get(cacheHigh, idx), array.get(cacheLow, idx)]
    else
        hi = rangeHigh(bar_index-cX, o)
        lo = rangeLow(bar_index-cX, o)
        array.push(cacheKeys, key)
        array.push(cacheHigh, hi)
        array.push(cacheLow, lo)
        [hi, lo]

// isNotDuplicate: true if p is not a duplicate of the most recently stored pattern
// of the same type/direction. Prevents storing the same XABC structure twice
// when multiple pivot lengths match the same structure.

isNotDuplicate(p) =>
    comp = storageFor(p.bull,p.tp)
    h.xabcd_harmonic last = array.size(comp) == 0 ? na : array.get(comp,array.size(comp)-1)
    na(last) ? true : last.x.x!=p.x.x or last.a.x!=p.a.x or last.b.x!=p.b.x or last.c.x!=p.c.x
    
// storeIncomplete: stores a validated XABC structure in inc[].
// Checks for duplicates in inc[] and pending[] before adding.
// isBull named to avoid shadowing the 't' library alias — all library calls
// inside this function route through outer-scope helpers that resolve 't' correctly.

storeIncomplete(isBull,h1,h2,h3,h4,h5,h6,xX,xY,aX,aY,bX,bY,cX,cY) =>
    btps = array.from(h1,h2,h3,h4,h5,h6)
    tps = util.boolToIntArr(btps)

    int dX = na
    float dY = na
    exists = false
    iN = array.size(incompletePatterns)
    iP = array.size(pending)
    if iN > 0
        for i=0 to iN-1
            p = array.get(incompletePatterns,iN-1-i)
            if p.x.x==xX and p.a.x==aX and p.b.x==bX
                if p.c.x == cX
                    exists := true
                else
                    pidCacheRemove(p.pid)
                    array.remove(incompletePatterns,iN-1-i)
                    erasePattern(p)
                break
    if exists==false and iP > 0
        for i=0 to iP-1
            p = array.get(pending,iP-1-i)
            if p.x.x==xX and p.a.x==aX and p.b.x==bX and p.c.x==cX
                exists := true
                break
    if exists == false
        for tpe in tps
            tp = tpe+1
            if exists == false
                pat = h.init(xX,xY,aX,aY,bX,bY,cX,cY,dX,dY,params,tp)
                if not na(pat)
                    [_,eC,_] = entry(pat)

                    tolOk = patternRatiosPassBand(pat, false)
                    if tolOk
                        if isNotDuplicate(pat)
                            array.push(incompletePatterns,pat)
                            pidCacheAdd(pat.pid)
                            debugLog("New incomplete " + h.get_symbol(pat.tp), cX, cY, isBull)
                            if incOn and (not na(eC) or not e_afterC)
                                drawPattern(pat)
                            if a_type == "Potential patterns" or a_type == "Both"
                                alert(alertMsg(pat),alert.freq_once_per_bar_close)
                        else
                            debugLog("Skip duplicate incomplete", cX, cY, isBull)
                    else if not tolOk
                        debugLog("Skip incomplete: fib band mismatch", cX, cY, isBull)

// setTargets: applies T1/T2 target strings to a pattern via h.set_target().

setTargets(p) =>
    p.t1 := rangeTargetFromD(p.bull, p.x.y, p.a.y, p.b.y, p.c.y, p.d.y, 0.382)
    p.t2 := rangeTargetFromD(p.bull, p.x.y, p.a.y, p.b.y, p.c.y, p.d.y, 0.618)

commitPattern(p,force=false) =>
    if patternRatiosPassBand(p, true)
        a = storageFor(p.bull,p.tp)
        array.push(a,p)
        pidCacheAdd(p.pid)
        if force == false
            if e_afterD
                removeIncomplete(h.incomplete_pid(p))
            p.invalid_d := false
        setTargets(p)
        showPattern = hsOn==false or belowScoreThreshold(p)==false
        if showPattern
            drawPattern(p)
        [upper,lower] = h.prz_range(p)
        p.stop := ta.harmonic_xabcd_stop(canonStopMode,stopPct,p.bull,p.x.y,p.d.y,upper,lower,p.t1,p.e.y)
        [eLvl,_,_] = entry(p)
        tradePlanOk = na(eLvl) ? true : tradeLevelsValid(p, eLvl)
        noEntryNow = entryCandidatesInvalid(p)
        if belowScoreThreshold(p)==false and not noEntryNow and tradePlanOk
            array.push(pending,p)
            pidCacheAdd(p.pid)
        else if noEntryNow
            debugLog("Skip pending: entry beyond T1", p.d.x, p.d.y, p.bull)
        else if not tradePlanOk
            debugLog("Skip pending: invalid trade geometry", p.d.x, p.d.y, p.bull)
        if showPattern and (a_type == "Complete patterns" or a_type == "Both")
            alert(alertMsg(p),alert.freq_once_per_bar_close)

// finalizePattern: deduplication + update logic for complete patterns.
// Same XABC + lower-scoring D → replace. If old had entry hit → update
// in-place to preserve entry tracking continuity.

finalizePattern(p,force=false) =>
    bool lasteH = na
    h.xabcd_harmonic pat = na
    a = storageFor(p.bull,p.tp)
    if array.size(a) > 0
        last = array.get(a,array.size(a)-1)

        if p.a.x!=last.a.x or p.b.x!=last.b.x or p.c.x!=last.c.x
            commitPattern(p,force)
            pat := p
        
        else if (p.bull and p.d.y < last.d.y) or (p.bull==false and p.d.y > last.d.y)
            if (last.score <= p.score) or force or last.invalid_d
                if last.eHit
                    lasteH := true
                    if force==false
                        last.invalid_d := false
                    h.init(last.x.x,last.x.y,last.a.x,last.a.y,last.b.x,last.b.y,last.c.x,last.c.y,p.d.x,p.d.y,params,last.tp,last)
                    [upper,lower] = h.prz_range(last)
                    last.stop := ta.harmonic_xabcd_stop(canonStopMode,stopPct,last.bull,last.x.y,last.d.y,upper,lower,last.t1,last.e.y)
                    drawPattern(last)
                    setTargets(last)
                    pat := last
                else
                    removePending(last.pid)
                    oldPat = array.pop(a)
                    pidCacheRemove(oldPat.pid)
                    erasePattern(oldPat)
                    commitPattern(p,force)
                    pat := p
    else
        commitPattern(p,force)
        pat := p
    
    if not na(pat)
        if lasteH
            if not na(pat.e.x) and not na(pat.e.y)
                draw.eHitLbl(pat.e.x,pat.e.y,pat.d.x,pat.d.y,p.bull,true)
        else
            [eHit,eX,eY] = entryHit(p)
            if eHit
                pat.eHit := true
                pat.e.x := eX
                pat.e.y := eY
                [upper,lower] = h.prz_range(pat)
                pat.stop := ta.harmonic_xabcd_stop(canonStopMode,stopPct,pat.bull,pat.x.y,pat.d.y,upper,lower,pat.t1,pat.e.y)
                if not na(eX) and not na(eY)
                    draw.eHitLbl(eX,eY,pat.d.x,pat.d.y,pat.bull)
                refreshPatternLabel(pat)
        ""

pendingShouldKeep(bool expired, bool eH, bool t1h, bool t2h, bool sH) =>
    not (expired or (eH and (not na(t2h) or t1h == false or sH)))

pendingEntryChanged(h.xabcd_harmonic ip, bool eH) =>
    (eH != ip.eHit) or (eH and na(ip.eHit)) or (eH==false and na(ip.eHit))

pendingNeedsRefresh(h.xabcd_harmonic ip, bool expired, bool eH, bool t1h, bool t2h, bool sH) =>
    expired or (eH and ((not na(t1h) and na(ip.t1Hit)) or (not na(t2h) and na(ip.t2Hit)))) or pendingEntryChanged(ip, eH) or sH

updatePendingPatterns() =>
    h.xabcd_harmonic[] new = array.new<h.xabcd_harmonic>()
    if array.size(pending) > 0
        for i=0 to array.size(pending)-1
            ip = array.get(pending,i)
            [eH,eHx,eHy] = entryHit(ip)
            liveLimit = pendingLimit(ip.x.x,ip.d.x)
            expired = bar_index >= (ip.d.x + liveLimit + 1) or eH==false
            [t1h,t2h,sH,t1x,t1y,t2x,t2y] = success(ip)
            if pendingNeedsRefresh(ip, expired, eH, t1h, t2h, sH)
                if (eH or eH==false) and na(ip.eHit)
                    ip.eHit := eH
                    ip.e.x := eHx
                    ip.e.y := eHy
                    if eH
                        [upper,lower] = h.prz_range(ip)
                        ip.stop := ta.harmonic_xabcd_stop(canonStopMode,stopPct,ip.bull,ip.x.y,ip.d.y,upper,lower,ip.t1,ip.e.y)
                        if lifecycle_guard_strict and not tradeLevelsValid(ip, ip.e.y)
                            ip.eHit := false
                            ip.e.x := na
                            ip.e.y := na
                            eH := false
                            expired := true
                            lifecycleDebug("Rejected entry: invalid trade geometry", ip)
                    if not na(eHx) and not na(eHy)
                        draw.eHitLbl(eHx,eHy,ip.d.x,ip.d.y,ip.bull)
                    debugLog(eH ? "Entry hit" : "Entry missed/expired", ip.d.x, ip.d.y, ip.bull)
                if t1h and na(ip.t1Hit)
                    ip.t1Hit := true
                    draw.tHitLbl(t1x,t1y,eHx,eHy,ip.bull)
                    debugLog("Target 1 hit", t1x, t1y, ip.bull)
                else if t1h == false
                    ip.t1Hit := false
                    draw.sHitLbl(t1x,t1y,eHx,eHy,ip.bull)
                    debugLog("Stopped before T1", t1x, t1y, ip.bull)
                if sH
                    ip.sHit := true
                    debugLog("Stop hit", ip.d.x, ip.d.y, ip.bull)
                if t2h
                    ip.t2Hit := true
                    draw.tHitLbl(t2x,t2y,eHx,eHy,ip.bull)
                    debugLog("Target 2 hit", t2x, t2y, ip.bull)
            if lifecycle_guard_strict
                sanitizeLifecycle(ip)
                if ip.eHit == false
                    expired := true
            keepPending = pendingShouldKeep(expired, ip.eHit, ip.t1Hit, ip.t2Hit, ip.sHit)
            if keepPending
                array.push(new,ip)
            else if debug_lifecycle
                lifecycleDebug("Removed from pending (expired/resolved)", ip)
            if pendingNeedsRefresh(ip, expired, eH, t1h, t2h, sH) or lifecycle_guard_strict
                refreshPatternLabel(ip)
    new

// updateIncompletePatterns: runs every bar on inc[].
// Removes patterns whose structure broke or time window expired.
// If afterC entry is enabled and price hits entry level, promotes pattern
// to complete with invalid_d=true (D unconfirmed by pivot).
// Ownership hand-off: promoted patterns leave incompletePatterns and move into
// finalize/pending flow; this function no longer mutates them afterward.

updateIncompletePatterns() =>
    h.xabcd_harmonic[] new = array.new<h.xabcd_harmonic>()
    if array.size(incompletePatterns) > 0
        for p in incompletePatterns
            [upper,lower] = h.prz_range(p)
            tLimit = incTLimit(p.x.x,p.c.x)
            [eH,eHx,eHy] = entryHit(p)
            if eH and e_afterC
                if isNotDuplicate(p)
                    p.d.x := eHx
                    p.d.y := eHy
                    p.invalid_d := true
                    if patternRatiosPassBand(p, true)
                        pidCacheRemove(p.pid)
                        erasePattern(p)
                        finalizePattern(p,true)
                        debugLog("Promoted after C entry", eHx, eHy, p.bull)
                    else
                        pidCacheRemove(p.pid)
                        erasePattern(p)
                        debugLog("Skip promoted: fib band mismatch", eHx, eHy, p.bull)
                else
                    pidCacheRemove(p.pid)
                    erasePattern(p)
                    debugLog("Discarded duplicate after C", p.c.x, p.c.y, p.bull)
            else if bar_index >= (p.c.x + tLimit + 1) or (p.bull and (high > p.c.y or low < lower)) or (p.bull==false and (low < p.c.y or high > upper))
                timedOut = bar_index >= (p.c.x + tLimit + 1)
                pidCacheRemove(p.pid)
                erasePattern(p)
                debugLog(timedOut ? "Incomplete timed out" : "Incomplete invalidated", p.c.x, p.c.y, p.bull)
            else
                array.push(new,p)
    new

// drawProjectionOverlay: draws forward-projection overlay for the most recent
// pending pattern — entry zone, stop, T1/T2, PRZ levels.
// Clears and redraws every bar while pattern is active.

drawProjectionOverlay() =>
    if array.size(pending) > 0
        last = array.get(pending,array.size(pending)-1)
        if h.is_complete(last)
            liveLimit = pendingLimit(last.x.x,last.d.x)
            if (last_bar_index - last.d.x) <= liveLimit
                clearProjectionOverlay()
                [highest,lowest] = h.prz_range(last)
                [bcNt,_] = harmonic_xabcd_targets(last.bull,last.x.y,last.a.y,last.b.y,last.c.y,last.prz_bN)
                [bcFt,_] = harmonic_xabcd_targets(last.bull,last.x.y,last.a.y,last.b.y,last.c.y,last.prz_bF)
                [xaNt,_] = harmonic_xabcd_targets(last.bull,last.x.y,last.a.y,last.b.y,last.c.y,last.prz_xN)
                [xaFt,_] = harmonic_xabcd_targets(last.bull,last.x.y,last.a.y,last.b.y,last.c.y,last.prz_xF)
                stop = last.stop
                [e,_,_] = entry(last)
                entry = na(last.e.y) ? e : last.e.y
                col = patColors(last.tp, last.bull)
                [ln,lb,lf] = draw.xabcd_inProgress(last.bull,last.tp,liveLimit>500?500:liveLimit,entry,stop,last.t1,last.t2,bcNt,bcFt,xaNt,xaFt,last.x.x,last.x.y,last.a.y,last.b.x,last.b.y,last.c.y,last.d.x,last.d.y,col.line,col.line,l_txt)
                for l in ln
                    array.push(fullIpLn,l)
                for l in lb
                    array.push(fullIpL,l)
                for l in lf
                    array.push(fullIpLf,l)
            else
                clearProjectionOverlay()
        else
            clearProjectionOverlay()
    else
        clearProjectionOverlay()

// Color helpers for table cells
pctColor(float v) =>
    v >= 50 ? color.new(#26A69A, 20) : v >= 30 ? color.new(#FF9800, 20) : color.new(#EF5350, 20)

retColor(float v) =>
    v >= 0 ? color.new(#26A69A, 20) : color.new(#EF5350, 20)

writeStatsRow(table t, int r, string c0, color c0bg, string c1, color c1bg, string c2, color c2bg, string st1, float t1pct, string st2, float t2pct, string ar, float avgR, string rbull, float avgBullR, string rbear, float avgBearR, string rbullTot, float totBullR, string rbearTot, float totBearR, string tr, float totR, string srr, float avgRR, color naBg) =>
    table.cell(t, 0, r, c0, bgcolor=c0bg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 1, r, c1, bgcolor=c1bg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 2, r, c2, bgcolor=c2bg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 3, r, st1, bgcolor=not na(t1pct) ? pctColor(t1pct) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 4, r, st2, bgcolor=not na(t2pct) ? pctColor(t2pct) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 5, r, ar, bgcolor=not na(avgR) ? retColor(avgR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 6, r, rbull, bgcolor=not na(avgBullR) ? retColor(avgBullR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 7, r, rbear, bgcolor=not na(avgBearR) ? retColor(avgBearR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 8, r, rbullTot, bgcolor=not na(totBullR) ? retColor(totBullR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 9, r, rbearTot, bgcolor=not na(totBearR) ? retColor(totBearR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 10, r, tr, bgcolor=not na(totR) ? retColor(totR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)
    table.cell(t, 11, r, srr, bgcolor=not na(avgRR) ? retColor(avgRR) : naBg, text_color=color.white, text_halign=text.align_center, text_size=size.small)

calcTradeReturn(bool bull, float eY, float t1, float t2, float stop, bool t1Hit, bool t2Hit, bool sHit) =>
    float r = na
    float rr = na
    int addT1 = 0
    int addT2 = 0
    bool isClosed = false
    hasRR = not na(stop) and not na(eY) and not na(t1)
    if t2Hit
        r := bull ? (((t1/eY) - 1) * 0.5) + (((t2/eY) - 1) * 0.5) : (((eY/t1) - 1) * 0.5) + (((eY/t2) - 1) * 0.5)
        if hasRR
            rr := math.abs(eY - t1) / math.max(math.abs(stop - eY), 0.0001)
        addT2 := 1
        addT1 := 1
        isClosed := true
    else if t1Hit
        rT1 = bull ? (t1/eY) - 1 : (eY/t1) - 1
        rRemain = sHit and not na(stop) ? (bull ? (stop/eY) - 1 : (eY/stop) - 1) : 0.0
        r := (rT1 * 0.5) + (rRemain * 0.5)
        if hasRR
            rr := math.abs(eY - t1) / math.max(math.abs(stop - eY), 0.0001)
        addT1 := 1
        isClosed := true
    else if sHit
        r := bull ? (stop/eY) - 1 : (eY/stop) - 1
        isClosed := true
    [r, rr, addT1, addT2, isClosed]

// backtestStatsFor: computes backtest stats for one pattern type.
// Bull return = (exit/entry)-1. Bear return = (entry/exit)-1.
// T2 hits use 50/50 split exit model (half at T1, half at T2).
// Pushes results to global accumulators for the Total row.

backtestStatsFor(tp) =>
    a1 = storageFor(true, tp)
    a2 = storageFor(false, tp)
    sumR = 0.0
    sumBullR = 0.0
    sumBearR = 0.0
    rCount = 0
    bullRCount = 0
    bearRCount = 0
    rrSum = 0.0
    rrCount = 0
    t1_tot = 0
    t2_tot = 0
    closed = 0
    closedBull = 0
    closedBear = 0

    for dir = 0 to 1
        isBull = dir == 0
        arr = isBull ? a1 : a2
        if array.size(arr) > 0
            for p in arr
                if (not na(p.t1Hit) or p.sHit) and p.eHit
                    if tradeLevelsValid(p, p.e.y)
                        [r, rr, addT1, addT2, isClosed] = calcTradeReturn(isBull, p.e.y, p.t1, p.t2, p.stop, p.t1Hit == true, p.t2Hit == true, p.sHit)
                        if isClosed and not na(r)
                            sumR += r
                            rCount += 1
                            if isBull
                                sumBullR += r
                                bullRCount += 1
                            else
                                sumBearR += r
                                bearRCount += 1
                            if not na(rr)
                                rrSum += rr
                                rrCount += 1
                            t1_tot += addT1
                            t2_tot += addT2
                            closed += 1
                            if isBull
                                closedBull += 1
                            else
                                closedBear += 1
                    else
                        debugLog("Skip stats: invalid trade geometry", p.d.x, p.d.y, p.bull)

    tot   = array.size(a1) + array.size(a2)
    avgR  = safeAvg(sumR, rCount) * 100
    totR  = sumR * 100
    avgBullR = safeAvg(sumBullR, bullRCount) * 100
    avgBearR = safeAvg(sumBearR, bearRCount) * 100
    totBullR = sumBullR * 100
    totBearR = sumBearR * 100
    avgRR = safeAvg(rrSum, rrCount)

    array.push(accPatternCount, tot)
    array.push(accTradeCount, closed)
    array.push(accT1Hits, t1_tot)
    array.push(accT2Hits, t2_tot)
    if not na(totR)
        array.push(accTotReturn, totR)

    t1pct = closed > 0 ? (t1_tot / closed) * 100 : float(na)
    t2pct = closed > 0 ? (t2_tot / closed) * 100 : float(na)
    st1   = not na(t1pct) ? pctStr(t1pct) : "NA"
    st2   = not na(t2pct) ? pctStr(t2pct) : "NA"
    ravg  = not na(avgR)  ? pctStr(avgR) : "NA"
    rbull = not na(avgBullR) ? pctStr(avgBullR) : "NA"
    rbear = not na(avgBearR) ? pctStr(avgBearR) : "NA"
    rtot  = not na(totR)  ? pctStr(totR) : "NA"
    srr   = not na(avgRR) ? str.tostring(avgRR, "#.##")       : "NA"
    rbullTot = not na(totBullR) ? pctStr(totBullR) : "NA"
    rbearTot = not na(totBearR) ? pctStr(totBearR) : "NA"

    [str.tostring(tot), str.tostring(closed), st1, st2, ravg, rbull, rbear, rtot, srr, rbullTot, rbearTot, t1pct, t2pct, avgR, avgBullR, avgBearR, totR, totBullR, totBearR, avgRR, rrSum, rrCount, closedBull, closedBear]


// printStats: renders backtest stats table at bottom-left. Toggled by show_stats.
// One row per active pattern type + Total row. Symbol cells use pattern colors.
// T1%/T2% color-coded by threshold. Return cells green/red by sign.
// Accumulators cleared after render to avoid double-counting on redraws.

printStats() =>
    if barstate.islast
        nR  = array.size(includeTps) + 3
        r   = 0
        table.clear(statsTbl, 0, 0, 11, nR-1)
        bullClosedAll = 0
        bearClosedAll = 0
        bullRetSumAll = 0.0
        bearRetSumAll = 0.0
        rrSumAll = 0.0
        rrCountAll = 0
        table.cell(statsTbl, 0, 0, " ",         text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 1, 0, "Pat",       text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 2, 0, "Trd",       text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 3, 0, "T1 %",      text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 4, 0, "T2 %",      text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 5, 0, "Avg R%",    text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 6, 0, "Bull Avg",  text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 7, 0, "Bear Avg",  text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 8, 0, "Bull Tot",  text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 9, 0, "Bear Tot",  text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 10, 0, "Tot R%",   text_color=color.white, text_halign=text.align_center, text_size=size.small)
        table.cell(statsTbl, 11, 0, "R:R",      text_color=color.white, text_halign=text.align_center, text_size=size.small)

        for tp in includeTps
            r += 1
            [tot,trd,st1,st2,ar,rbull,rbear,tr,srr,rbullTot,rbearTot,t1pct,t2pct,avgR,avgBullR,avgBearR,totR,totBullR,totBearR,avgRR,rrSum,rrCount,closedBull,closedBear] = backtestStatsFor(tp)
            bullClosedAll += closedBull
            bearClosedAll += closedBear
            bullRetSumAll += na(totBullR) ? 0.0 : totBullR
            bearRetSumAll += na(totBearR) ? 0.0 : totBearR
            rrSumAll += na(rrSum) ? 0.0 : rrSum
            rrCountAll += rrCount
            patCol = patColors(tp, true)
            writeStatsRow(statsTbl, r, tablePatternBadge(tp), color.new(patCol.line, 60), tot, color(na), trd, color(na), st1, t1pct, st2, t2pct, ar, avgR, rbull, avgBullR, rbear, avgBearR, rbullTot, totBullR, rbearTot, totBearR, tr, totR, srr, avgRR, C_NA_BG)

        r += 1
        totalClosed  = array.sum(accTradeCount)
        t1Total      = totalClosed > 0 ? pctStr((array.sum(accT1Hits) / totalClosed) * 100) : "NA"
        t2Total      = totalClosed > 0 ? pctStr((array.sum(accT2Hits) / totalClosed) * 100) : "NA"
        t1TotalV     = totalClosed > 0 ? (array.sum(accT1Hits) / totalClosed) * 100 : float(na)
        t2TotalV     = totalClosed > 0 ? (array.sum(accT2Hits) / totalClosed) * 100 : float(na)
        sumRtot      = not na(array.sum(accTotReturn)) ? array.sum(accTotReturn) : float(na)
        avgRtot      = (not na(sumRtot) and totalClosed > 0) ? (sumRtot / totalClosed) : float(na)
        arTotal      = not na(avgRtot) ? pctStr(avgRtot) : "NA"
        trTotal      = not na(sumRtot) ? pctStr(sumRtot) : "NA"
        bullAvgTotalV = bullClosedAll > 0 ? (bullRetSumAll / bullClosedAll) : float(na)
        bearAvgTotalV = bearClosedAll > 0 ? (bearRetSumAll / bearClosedAll) : float(na)
        bullAvgTotal = not na(bullAvgTotalV) ? pctStr(bullAvgTotalV) : "NA"
        bearAvgTotal = not na(bearAvgTotalV) ? pctStr(bearAvgTotalV) : "NA"
        bullTotTotal = not na(bullRetSumAll) ? pctStr(bullRetSumAll) : "NA"
        bearTotTotal = not na(bearRetSumAll) ? pctStr(bearRetSumAll) : "NA"
        avgRRtot     = rrCountAll > 0 ? (rrSumAll / rrCountAll) : float(na)
        str_rrTotal  = not na(avgRRtot) ? str.tostring(avgRRtot, "#.##") : "NA"

        totalBg = color.new(color.gray, 70)
        writeStatsRow(statsTbl, r, "Total", totalBg, str.tostring(array.sum(accPatternCount)), totalBg, str.tostring(totalClosed), totalBg, t1Total, t1TotalV, t2Total, t2TotalV, arTotal, avgRtot, bullAvgTotal, bullAvgTotalV, bearAvgTotal, bearAvgTotalV, bullTotTotal, bullRetSumAll, bearTotTotal, bearRetSumAll, trTotal, sumRtot, str_rrTotal, avgRRtot, totalBg)

        r += 1
        keyTxt = "✅ = Success | ❌ = Failure | 🕝 = Timed out* | ⛔ = No entry* | ⏳ = In progress* \n*Not included in Success Rate/Return % statistics"
        table.cell(statsTbl, 0, r, keyTxt, text_color=color.white, text_halign=text.align_right, text_size=size.small)
        table.merge_cells(statsTbl, 0, r, 11, r)
        array.clear(accPatternCount), array.clear(accTradeCount), array.clear(accT1Hits), array.clear(accT2Hits), array.clear(accTotReturn)

statsSignature() =>
    sig = 0
    sig += array.size(bullGart) * 2 + array.size(bearGart) * 3
    sig += array.size(bullBat) * 5 + array.size(bearBat) * 7
    sig += array.size(bullBfly) * 11 + array.size(bearBfly) * 13
    sig += array.size(bullCrab) * 17 + array.size(bearCrab) * 19
    sig += array.size(bullShark) * 23 + array.size(bearShark) * 29
    sig += array.size(incompletePatterns) * 31
    sig += array.size(pending) * 37
    if array.size(pending) > 0
        lp = array.get(pending, array.size(pending)-1)
        st = patternState(lp)
        sig += (lp.d.x + 1) * 41
        sig += st * 43
        sig += (lp.tp + 1) * 47
        sig += lp.bull ? 53 : 59
    sig

reconcileStatsView() =>
    nextSig = lastStatsSig
    nextPrevShow = prevShowStats
    if barstate.islast
        if show_stats
            sig = statsSignature()
            if na(lastStatsSig) or sig != lastStatsSig or not prevShowStats
                printStats()
                nextSig := sig
            nextPrevShow := true
        else if not na(statsTbl) and statsTblRows > 0
            if prevShowStats
                table.clear(statsTbl, 0, 0, 11, statsTblRows-1)
            nextPrevShow := false
    [nextSig, nextPrevShow]
// isValidPointD: validates a candidate D point for an incomplete pattern.
// Checks: time window, leg symmetry (pctAsym), price structure (D beyond C in
// correct direction), and BD/XD ratio via t.test_cd().

isValidPointD(p,dX,dY) =>

    var bool[] _ptypes1 = array.from(true,false,false,false,false,false)
    var bool[] _ptypes2 = array.from(false,true,false,false,false,false)
    var bool[] _ptypes3 = array.from(false,false,true,false,false,false)
    var bool[] _ptypes4 = array.from(false,false,false,true,false,false)
    var bool[] _ptypes5 = array.from(false,false,false,false,true,false)

    if dX <= (incTLimit(p.x.x,p.c.x) + p.c.x)
        if ta.pat_xabcd_testSym(p.a.x-p.x.x, p.b.x-p.a.x, p.c.x-p.b.x, dX-p.c.x, pctAsym)
            [highBound, lowBound] = rangeBoundsFromC(p.c.x, 1)
            if ((p.bull and dY <= lowBound) or (p.bull==false and dY >= highBound)) and ((p.bull and p.c.y >= highBound) or (p.bull==false and p.c.y <= lowBound))
                xa = math.abs(p.x.y - p.a.y)
                bc = math.abs(p.b.y - p.c.y)
                cd = math.abs(p.c.y - dY)
                ad = math.abs(p.a.y - dY)
                xc = math.abs(p.x.y - p.c.y)
                tp = p.tp
                if tp < 1 or tp > 5
                    debugLog("Skip unknown pattern type: " + str.tostring(tp), dX, dY, p.bull)
                    false
                else
                    p_types = switch tp
                        1 => _ptypes1
                        2 => _ptypes2
                        3 => _ptypes3
                        4 => _ptypes4
                        => _ptypes5
                    [t1,t2,t3,t4,t5,t6] = ta.test_cd(cd,bc,xa,xc,ad,pctErr,p_types)
                    cdOk = t1 or t2 or t3 or t4 or t5 or t6
                    if cdOk
                        cand = h.init(p.x.x, p.x.y, p.a.x, p.a.y, p.b.x, p.b.y, p.c.x, p.c.y, dX, dY, params, p.tp)
                        not na(cand) and patternRatiosPassBand(cand, true)
                    else
                        false
            else
                false
        else
            false
    else
        false

// Tie-break policy for same XABC/type candidate upserts:
// 1) More extreme D in pattern direction (lower for bull, higher for bear)
// 2) Higher score when D is equal
candidateIsBetter(h.xabcd_harmonic cand, h.xabcd_harmonic ex) =>
    cand.bull ? (cand.d.y < ex.d.y or (cand.d.y == ex.d.y and cand.score > ex.score)) : (cand.d.y > ex.d.y or (cand.d.y == ex.d.y and cand.score > ex.score))

queueDetectedCandidate(h.xabcd_harmonic[] candidates, int[] qx, int[] qa, int[] qb, int[] qc, int[] qtp, bool[] qbull, h.xabcd_harmonic cand) =>
    idx = -1
    nQ = array.size(candidates)
    if nQ > 0
        for i=0 to nQ-1
            same = array.get(qbull, i) == cand.bull and array.get(qtp, i) == cand.tp and array.get(qx, i) == cand.x.x and array.get(qa, i) == cand.a.x and array.get(qb, i) == cand.b.x and array.get(qc, i) == cand.c.x
            if same
                idx := i
                break
    if idx < 0
        array.push(candidates, cand)
        array.push(qx, cand.x.x)
        array.push(qa, cand.a.x)
        array.push(qb, cand.b.x)
        array.push(qc, cand.c.x)
        array.push(qtp, cand.tp)
        array.push(qbull, cand.bull)
    else
        ex = array.get(candidates, idx)
        if candidateIsBetter(cand, ex)
            array.set(candidates, idx, cand)

tryQueuePointD(h.xabcd_harmonic src, int dX, float dY, h.xabcd_harmonic[] candidates, int[] qx, int[] qa, int[] qb, int[] qc, int[] qtp, bool[] qbull) =>
    if isValidPointD(src, dX, dY)
        cand = h.init(src.x.x, src.x.y, src.a.x, src.a.y, src.b.x, src.b.y, src.c.x, src.c.y, dX, dY, params, src.tp)
        if not na(cand)
            queueDetectedCandidate(candidates, qx, qa, qb, qc, qtp, qbull, cand)

pivotConfirmed(float s, int tb, bool isLowPivot) =>
    bool ok = true
    for i=0 to tb-1
        if isLowPivot ? s[i] < s[tb] : s[i] > s[tb]
            ok := false
            break
    if ok
        for i=tb+1 to tb+tb
            if isLowPivot ? s[i] < s[tb] : s[i] > s[tb]
                ok := false
                break
    ok


// detectPointD: checks bar at offset t_b as a local low (bullish) or high (bearish).
// Tests all inc[] and pending[] patterns for valid D completion at that pivot.

detectPointD() =>
    tb = effectiveValidationBars()
    x = bar_index[tb]
    isLow = pivotConfirmed(low, tb, true)
    isHigh = pivotConfirmed(high, tb, false)
    if isLow or isHigh
        h.xabcd_harmonic[] new = array.new<h.xabcd_harmonic>()
        int[] qx = array.new_int()
        int[] qa = array.new_int()
        int[] qb = array.new_int()
        int[] qc = array.new_int()
        int[] qtp = array.new_int()
        bool[] qbull = array.new_bool()
        for p in incompletePatterns
            if isLow and p.bull
                tryQueuePointD(p, x, low[tb], new, qx, qa, qb, qc, qtp, qbull)
            if isHigh and p.bull==false
                tryQueuePointD(p, x, high[tb], new, qx, qa, qb, qc, qtp, qbull)
        for p2 in pending
            if isLow and p2.bull
                tryQueuePointD(p2, x, low[tb], new, qx, qa, qb, qc, qtp, qbull)
            if isHigh and p2.bull==false
                tryQueuePointD(p2, x, high[tb], new, qx, qa, qb, qc, qtp, qbull)
        for n in new
            if not na(n)
                finalizePattern(n)


// find_pattern: detects XABC structures at a specific pivot length.
// Validates XB/AC ratios. isBull named to avoid shadowing 't' library alias.

find_pattern(pl,isBull=true) =>
    if ((isBull and bullOn) or (isBull==false and bearOn))
        [f,xX,xY,aX,aY,bX,bY,cX,cY] = ta.pat_xabcdIncomplete(isBull,pl)
        if f and (i_lb==false or bar_index >= last_bar_index-i_lbn)
            [isValid,h1,h2,h3,h4,h5,h6] = ta.harmonic_xabcd_validateIncomplete(xX,xY,aX,aY,bX,bY,cX,cY,pctErr,pctAsym,gartOn,batOn,bflyOn,crabOn,sharkOn,false)
            if isValid
                storeIncomplete(isBull,h1,h2,h3,h4,h5,h6,xX,xY,aX,aY,bX,bY,cX,cY)

effectiveMinPl() =>
    // Precedence: pivot_mode override > detection_preset > manual min_pl.
    pivot_mode == "Balanced (8)" ? 8 : pivot_mode == "Macro (15)" ? 15 : presetMinPl()


// find: runs find_pattern() across all pivot lengths from min_pl to 20.
// Running all lengths ensures detection across every pattern scale simultaneously.

find(isBull=true) =>
    mp = effectiveMinPl()
    if mp <= 3
        find_pattern(3,isBull)
    if mp <= 4
        find_pattern(4,isBull)
    if mp <= 5
        find_pattern(5,isBull)
    if mp <= 6
        find_pattern(6,isBull)
    if mp <= 7
        find_pattern(7,isBull)
    if mp <= 8
        find_pattern(8,isBull)
    if mp <= 9
        find_pattern(9,isBull)
    if mp <= 10
        find_pattern(10,isBull)
    if mp <= 11
        find_pattern(11,isBull)
    if mp <= 12
        find_pattern(12,isBull)
    if mp <= 13
        find_pattern(13,isBull)
    if mp <= 14
        find_pattern(14,isBull)
    if mp <= 15
        find_pattern(15,isBull)
    if mp <= 16
        find_pattern(16,isBull)
    if mp <= 17
        find_pattern(17,isBull)
    if mp <= 18
        find_pattern(18,isBull)
    if mp <= 19
        find_pattern(19,isBull)
    find_pattern(20,isBull)


// Execution order matters:
// 1) updateIncompletePatterns() prunes/promotes incomplete candidates.
// 2) updatePendingPatterns() advances active trades and resolves outcomes.
// 3) find()/detectPointD() discover new candidates/completions.
// 4) Last-bar render updates cluster filter, projection overlay, and tables.
// This keeps one-way ownership flow: incompletePatterns -> pending -> stats.
//
// Developer invariants:
// 1) Pending state flags (eHit/t1Hit/t2Hit/sHit) are only mutated in updatePendingPatterns().
// 2) Completed/pending label refresh should route through refreshPatternLabel().
// 3) detectPointD candidate dedupe/upsert should route through tryQueuePointD()/queueDetectedCandidate().
// 4) Ownership flow stays one-way: incompletePatterns -> pending -> finalized stats state.

// ─── MAIN ──────────────────────────────────────────────────

incompletePatterns:= updateIncompletePatterns()
pending := updatePendingPatterns()

if show_leg_mid_labels == false
    clearLegMidLabels()
else
    reconcileLegMidLabels()

find()
find(false)

detectPointD()

if barstate.islast
    nStatsRows = array.size(includeTps) + 3
    if na(statsTbl) or statsTblRows != nStatsRows
        statsTbl := table.new(position.bottom_left, 12, nStatsRows, bgcolor=C_NA_BG, border_width=1)
        statsTblRows := nStatsRows
    if not perf_gate_ui or cluster_ui_filter or array.size(hiddenClusterPids) > 0
        refreshClusterFilter()
    if not perf_gate_ui or array.size(pending) > 0
        drawProjectionOverlay()
    [nextSig, nextPrevShow] = reconcileStatsView()
    lastStatsSig := nextSig
    prevShowStats := nextPrevShow
    if show_fib_table
        printFibTable()
