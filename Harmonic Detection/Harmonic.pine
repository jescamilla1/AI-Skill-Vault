indicator("Harmonic Pattern Detection, Prediction, and Backtesting System","Exion Harmonics",overlay=true,max_lines_count=500,max_labels_count=500,max_bars_back=500)

// ============================================================
// Detection pipeline:
//   1. find() calls find_pattern() at each pivot length (min_pl–20)
//   2. t.pat_xabcdIncomplete() detects XABC structures from alternating
//      pivot highs/lows of the required bar length
//   3. t.harmonic_xabcd_validateIncomplete() checks XB and AC ratios
//      against theoretical fib values within pctErr% tolerance
//   4. Valid structures enter inc[] awaiting point D
//   5. detectPointD() tests each new pivot's BD and XD ratios via
//      t.test_cd() — if valid, pattern completes
//   6. Complete patterns enter pending[]; entry/stop/targets are set
//      and the backtest tracks T1/T2 hits and stop hits each bar
//
// Ratio naming (used throughout and in tooltip):
//   XB = AB/XA retracement  — primary identifier, narrows pattern family
//   AC = BC/AB retracement  — confirms structure
//   BD = CD/BC extension    — D leg completion
//   XD = AD/XA ratio        — D point relative to full XA range
//
// Profit targets:
//   T1 = 0.382 and T2 = 0.618 of full harmonic range (highest-to-lowest),
//   both projected from point D in trade direction.
//
// Score (0–1, shown ×100):
//   Weighted average of:
//   - Leg accuracy (w_e):   1 - avg fib ratio error across all legs
//   - PRZ confluence (w_p): proximity of the two PRZ fib levels
//   - D/PRZ confluence (w_d): proximity of D to the PRZ levels
// ============================================================

import BagHoldingCat_ftw/TA/7 as ta
import reees/Draw/27 as draw
import reees/Utilities/5 as util
import reees/Pattern/1 as p
import BagHoldingCat_ftw/Obj_XABCD_Harmonic/1 as h

// ─── INPUTS ────────────────────────────────────────────────
// 01. Detection
var t_b          = input.int(1, "Pattern validation length (# trailing bars)", minval=1, group="01. Detection", tooltip="The number of bars after pivot point D (or point C for incomplete patterns) before a pattern is considered valid. This affects how soon patterns will be drawn and entries can be placed.")
var pctErr       = input.float(15.0, "Allowed fib ratio error %", step=1.0, minval=0.0, maxval=50.0, group="01. Detection", inline="err")
var fib_tol_band = input.string("10%", "Fib band", options=["5%","10%"], group="01. Detection", inline="err", tooltip="Require each detected leg ratio to be within this error band of the nearest supported fib level.")
var w_e          = input.float(4.0, "Weight", step=.1, minval=0.0, group="01. Detection", inline="err", tooltip="A leg is considered valid if its retracement (ΔY) ratio is within this % of the defined harmonic ratio. Weight determines the weight of retracement % error in the total score calculation for a pattern.")
var pctAsym      = input.float(2000.0, "Allowed leg length asymmetry %", step=1.0, minval=0.0, maxval=5000.0, group="01. Detection", tooltip="A leg is considered valid if its length (ΔX/number of bars) is within this % of the average length of the other legs in the pattern.")
var tLimitMult   = input.float(3, "Pattern time limit", group="01. Detection", step=.1, minval=.1, tooltip="Time limit for a completed pattern to reach the projected targets. Value is specified in terms of total pattern length (point X to point D), i.e. a value of 1 will allow one pattern length to elapse before the pattern times out and can no longer be considered successful. Patterns that time out will not count towards the success rates in the results table.")
var pendingMaxBars = input.int(0, "Hard pending cap bars (0=off)", minval=0, maxval=5000, group="01. Detection", tooltip="Optional absolute cap on bars a completed pattern can remain pending after D. 0 disables the cap. When set, effective pending timeout is min(pattern time limit, this cap).")
var incompleteMaxBars = input.int(0, "Hard incomplete cap bars (0=off)", minval=0, maxval=5000, group="01. Detection", tooltip="Optional absolute cap on bars an incomplete pattern can wait for D after C. 0 disables the cap. When set, effective incomplete timeout is min(asymmetry-derived limit, this cap).")
var detection_preset = input.string("Custom", "Detection preset", options=["Custom","Scalp","Swing","Macro+"], group="01. Detection", tooltip="Preset bundle for key detection knobs. Custom keeps manual values.")
var min_pl       = input.int(8, "Min pivot length", minval=3, maxval=20, group="01. Detection", tooltip="Minimum bars on each side of a pivot. Lower values detect more micro structures; higher values focus on macro swings.")
var pivot_mode   = input.string("Custom", "Pivot mode", options=["Custom","Balanced (8)","Macro (15)"], group="01. Detection", tooltip="Choose a one-of-three pivot presets. Custom uses Min pivot length; Balanced and Macro lock to 8 and 15.")
var w_p          = input.float(2.0, "Weight of PRZ level confluence", step=.1, minval=0.0, group="01. Detection", tooltip="Weight applied to Potential Reversal Zone fib level confluence in the total score calculation for a pattern. The closer together the two closest PRZ fib levels are, the higher the score.")
var w_d          = input.float(3.0, "Weight of point D / PRZ level confluence", step=.1, minval=0.0, group="01. Detection", tooltip="Weight applied to the confluence of point D with the Potential Reversal Zone levels in the total score calculation for a pattern. The closer point D is to either of the two confluent PRZ fib levels, the higher the score.")

