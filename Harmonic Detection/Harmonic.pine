var bearOn                    = input.bool(true, "Bearish", inline="type_b", group="04. Visibility & Filters")
var incOn                     = input.bool(true, "Potential/Incomplete", inline="type_b", group="04. Visibility & Filters")
var show_inc_prz              = input.bool(true, "Show PRZ levels on incomplete", inline="type_b", group="04. Visibility & Filters", tooltip="Show the BC Potential Reversal Zone target levels on incomplete (XABC) patterns.")
var hsOn                      = input.bool(true, "Only high scoring", inline="type_b", group="04. Visibility & Filters", tooltip="Show only patterns passing score entry threshold.")
var i_lb                      = input.bool(false, "Lookback bars", group="04. Visibility & Filters", inline="h")
var i_lbn                     = input.int(800, "", group="04. Visibility & Filters", inline="h", minval=50, maxval=5000, tooltip="Bars back to scan. Higher finds more history but adds load.")
var show_stats                = input.bool(true, "Show stats table", group="04. Visibility & Filters", tooltip="Toggle stats table.")
var cluster_ui_filter         = input.bool(false, "Cluster filter (display only)", group="04. Visibility & Filters", tooltip="Show only best-confidence pattern in overlapping same-side zones.")
var cluster_hist_completed_only = input.bool(true, "Historical: completed only", group="04. Visibility & Filters", tooltip="For historical clustering, keep completed patterns only.")
var cluster_d_window          = input.int(25, "Cluster time window (bars)", minval=1, maxval=500, group="04. Visibility & Filters", tooltip="Max D/C bar distance to treat patterns as same cluster.")
var cluster_price_mult        = input.float(1.0, "Cluster price overlap factor", minval=0.1, maxval=5.0, step=0.1, group="04. Visibility & Filters", tooltip="Cluster when PRZs overlap or centers are within width factor.")

// 05. Tooltips & Labels
var show_leg_mid_labels = input.bool(false, "Show leg midpoint labels", group="05. Tooltips & Labels", tooltip="Show XB/AC and BD/XD labels at leg midpoints.")
var leg_lbl_color_by_acc = input.bool(true, "Leg label color by fib accuracy", group="05. Tooltips & Labels", tooltip="Color midpoint labels by fib accuracy band.")
var leg_exact_eps_pct    = input.float(0.10, "Exact tolerance %", minval=0.0, step=0.01, group="05. Tooltips & Labels", tooltip="Error threshold treated as exact.")
var tt_show_trade_levels = input.bool(true, "Tooltip: trade levels", group="05. Tooltips & Labels", tooltip="Show Entry/Stop/T1/T2 in pattern tooltips.")
var tt_show_rr           = input.bool(true, "Tooltip: R:R", group="05. Tooltips & Labels", tooltip="Show R:R for T1/T2 when trade levels are available.")
var tt_show_leg_err      = input.bool(true, "Tooltip: leg error %", group="05. Tooltips & Labels", tooltip="Show fib error % for XB/AC/BD rows. XD error is intentionally omitted.")

// 06. Colors
var use_per_pattern = input.bool(true, "Use per-pattern colors", group="06. Colors", tooltip="On: per-pattern colors. Off: global bull/bear colors.")

