// ─── INPUTS ────────────────────────────────────────────────
// 01. Detection
var t_b          = input.int(1, "Pattern validation length (# trailing bars)", minval=1, group="01. Detection", tooltip="Bars to confirm pivot D (or C for incomplete). Higher = slower, cleaner signals.")
var pctErr       = input.float(15.0, "Allowed fib ratio error %", step=1.0, minval=0.0, maxval=50.0, group="01. Detection", inline="err")
var w_e          = input.float(4.0, "Weight", step=.1, minval=0.0, group="01. Detection", inline="err", tooltip="Score weight for leg fib-ratio accuracy.")
var pctAsym      = input.float(2000.0, "Allowed leg length asymmetry %", step=1.0, minval=0.0, maxval=5000.0, group="01. Detection", tooltip="Max leg-duration imbalance allowed vs other legs.")
var tLimitMult   = input.float(3, "Pattern time limit", group="01. Detection", step=.1, minval=.1, tooltip="Target timeout in pattern lengths (X->D). Timed-out patterns are excluded from stats.")
var pendingMaxBars = input.int(0, "Hard pending cap bars (0=off)", minval=0, maxval=5000, group="01. Detection", tooltip="Absolute pending cap after D. 0 disables. Effective cap is min(dynamic, cap).")
var incompleteMaxBars = input.int(0, "Hard incomplete cap bars (0=off)", minval=0, maxval=5000, group="01. Detection", tooltip="Absolute incomplete wait cap after C. 0 disables. Effective cap is min(dynamic, cap).")
var reject_nonpositive_proj_d = input.bool(true, "Reject projected D <= 0", group="01. Detection", tooltip="Skip incomplete patterns whose projected D is non-positive.")
var proj_d_max_ext_mult = input.float(3.0, "Projected D max extension x range (0=off)", minval=0.0, step=0.1, group="01. Detection", tooltip="Reject incompletes if projected D is farther than this multiple of XABC range from point C.")
var min_pl       = input.int(8, "Min pivot length", minval=3, maxval=20, group="01. Detection", tooltip="Minimum bars per pivot side. Lower = more micro patterns.")
var w_p          = input.float(2.0, "Weight of PRZ level confluence", step=.1, minval=0.0, group="01. Detection", tooltip="Score weight for PRZ-level confluence.")
var w_d          = input.float(3.0, "Weight of point D / PRZ level confluence", step=.1, minval=0.0, group="01. Detection", tooltip="Score weight for D proximity to PRZ.")

// 02. Pattern Types
