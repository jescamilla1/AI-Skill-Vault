var batOn        = input.bool(true, "Bat:          ", inline="bat", group="02. Pattern Types")
var bflyOn       = input.bool(true, "Butterfly:  ", inline="bfly", group="02. Pattern Types")
var crabOn       = input.bool(true, "Crab:        ", inline="crab", group="02. Pattern Types")
var sharkOn      = input.bool(true, "Shark:       ", inline="shark", group="02. Pattern Types")
var altBatOn     = input.bool(true, "Alt Bat:     ", inline="altbat", group="02. Pattern Types")
